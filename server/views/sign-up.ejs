<!DOCTYPE html>
<html>
<head>
    <title>Sign Up</title>
</head>

<body>

    <h1>Sign Up</h1>

    <form action="/signup" method="POST">
        
        <label for="firstname">
            Username
        </label>

        <input
            id="firstname"
            name="firstname"
            type="text"
            required
        >
        <label for="lastname">
            Username
        </label>

        <input
            id="lastname"
            name="lastname"
            type="text"
            required
        >

        <label for="username">
            Username
        </label>

        <input
            id="username"
            name="username"
            type="text"
            required
        >

        <label for="password">
            Password
        </label>

        <input
            id="password"
            name="password"
            type="password"
            required
        >
        <label for="confirmpassword">
            Confirm Password
        </label>

        <input
            id="confirmpassword"
            name="confirmpassword"
            type="password"
            required
        >
        <button type="submit">
            Sign Up
        </button>

    </form>

</body>
</html>